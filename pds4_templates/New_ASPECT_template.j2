<?xml-model href="https://pds.nasa.gov/pds4/img/v1/PDS4_IMG_1P00_1930.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/sp/v1/PDS4_SP_1P00_1330.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1O00.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/disp/v1/PDS4_DISP_1O00_1510.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_PSA_1O00_1500.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_HERA_1O00_1000.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>

<!--TODO: Change to rel path -->
<Product_Observational 
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:disp="http://pds.nasa.gov/pds4/disp/v1"
    xmlns:geom="http://pds.nasa.gov/pds4/geom/v1"
    xmlns:img="http://pds.nasa.gov/pds4/img/v1"
    xmlns:sp="http://pds.nasa.gov/pds4/sp/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pds="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:psa="http://psa.esa.int/psa/v1"
    xmlns:hera="http://pds.nasa.gov/pds4/mission/hera/v1"
    xsi:schemaLocation="
        http://pds.nasa.gov/pds4/pds/v1 https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1O00.xsd
        http://pds.nasa.gov/pds4/disp/v1 https://pds.nasa.gov/pds4/disp/v1/PDS4_DISP_1O00_1510.xsd
        http://pds.nasa.gov/pds4/geom/v1 https://pds.nasa.gov/pds4/geom/v1/PDS4_GEOM_1P00_19B0.xsd
        http://pds.nasa.gov/pds4/img/v1 https://pds.nasa.gov/pds4/img/v1/PDS4_IMG_1P00_1930.xsd
        http://pds.nasa.gov/pds4/sp/v1 https://pds.nasa.gov/pds4/sp/v1/PDS4_SP_1P00_1330.xsd 
        http://psa.esa.int/psa/v1 file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_PSA_1O00_1500.xsd
        http://pds.nasa.gov/pds4/mission/hera/v1 file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_HERA_1O00_1000.xsd
        "
 >
    <!--TODO: Check correct Bundle and Collection -->
    <Identification_Area>
        <logical_identifier>{{ main_logical_lid }}</logical_identifier>
        <version_id>{{ version_id | default('1.0') }}</version_id>
        <title>{{ title }}</title>
        <information_model_version>1.24.0.0</information_model_version>
        <product_class>Product_Observational</product_class>
        <Modification_History>
            <Modification_Detail>
                <modification_date>{{ modification_date }}</modification_date>
                <version_id>{{ version_id | default('1.0') }}</version_id>
                <description>Initial template.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>

    <Observation_Area>
        <Time_Coordinates>
            <!--TODO: acquisition stop time should be provided in telemetry or externally -->
            <start_date_time>{{ start_date_time }}</start_date_time>
            <stop_date_time>2026-04-23T10:30:35.467Z</stop_date_time>
        </Time_Coordinates>

        <!-- Primary Reesult Summary is optional (used in LTM)-->
        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <!-- Processing levels: Calibrated, Derived, Partially Processed, Raw, Telemetry-->
            <processing_level>{{ processing_level }}</processing_level>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Infrared</wavelength_range>
                <discipline_name>Spectroscopy</discipline_name>
            </Science_Facets>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Infrared</wavelength_range>
                <discipline_name>Imaging</discipline_name>
            </Science_Facets>
        </Primary_Result_Summary>

        <Investigation_Area>
            <name>Hera</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>{{mission_lid}}</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>

        <Observing_System>
            <name>{{ os_name }}</name>
            <Observing_System_Component>
                <name>ASPECT</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>{{ aspect_lid }}</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            <Observing_System_Component>
                <name>{{ channel }}</name>
                <type>Instrument</type>
                <Internal_Reference>
                    <!--TODO: check the correct lid reference -->
                    <lid_reference>{{ instrument_lid }}</lid_reference>
                    <reference_type>is_instrument</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
        </Observing_System>

        <Target_Identification>
            <name>{{ target }}</name>
            <type>Asteroid</type>
            <Internal_Reference>
                <lid_reference>{{ target_lid }}</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>

        <Mission_Area>
            <!-- wait for MAX table -->
            <psa:Mission_Information>
                <psa:mission_phase_name>ASPECT_Acquisition</psa:mission_phase_name>
                <psa:mission_phase_identifier>A2Acq1</psa:mission_phase_identifier>
            </psa:Mission_Information>
            <hera:Spacecraft_Status>
                <hera:milani_mission_phase>Stowed</hera:milani_mission_phase>
            </hera:Spacecraft_Status>
        </Mission_Area>

        <Discipline_Area>
            <!-- Image display guide (Vis, NIR1, NIR2 only: MIR has 1D spectrum, no spatial axes) -->
            {% if channel in ['Vis', 'NIR1', 'NIR2'] %}
            <disp:Display_Settings>
                <pds:Local_Internal_Reference>
                    <!-- Local identifier for the datacube defined in File_Area_observational-->
                    <pds:local_identifier_reference>{{ data_local_id }}</pds:local_identifier_reference>
                    <pds:local_reference_type>display_settings_to_array</pds:local_reference_type>
                </pds:Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Top to Bottom</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>
            {% endif %}

            <!-- Geometry dictionary-->
            <!-- These values comes from SPICE kernel and are optional to include-->
            {% if mk_file_name not in ['UNK', 'N/A'] %}
            <geom:Geometry>
                <!--TODO: fill out the metakernel information once it has been established -->
                <geom:SPICE_Kernel_Files>
                    <geom:SPICE_Kernel_Identification>
                        <geom:kernel_type>MK</geom:kernel_type>
                        <geom:spice_kernel_file_name>{{ mk_file_name }}</geom:spice_kernel_file_name>
                    </geom:SPICE_Kernel_Identification>
                </geom:SPICE_Kernel_Files>
                <!--TODO: fill accurate orbiter geometry -->
                <geom:Geometry_Orbiter>
                    <geom:geometry_start_time_utc>{{ start_date_time }}</geom:geometry_start_time_utc>
                    <geom:geometry_stop_time_utc>2026-04-23T10:30:35.467Z</geom:geometry_stop_time_utc>
                    {% if sc_distance not in ['UNK', 'N/A'] and target_distance not in ['UNK', 'N/A'] %}
                    <geom:Distances>
                        <geom:Distances_Specific>
                            {% if sc_distance not in ['UNK', 'N/A'] %}
                            <geom:spacecraft_heliocentric_distance unit="AU">{{ sc_distance }}</geom:spacecraft_heliocentric_distance>
                            {% endif %}
                            {% if target_distance not in ['UNK', 'N/A'] %}
                            <geom:spacecraft_target_center_distance unit="AU">{{ target_distance }}</geom:spacecraft_target_center_distance>
                            {% endif %}
                        </geom:Distances_Specific>
                    </geom:Distances>
                    {% endif %}
                    {% if solar_elongation not in ['UNK', 'N/A'] %}
                    <geom:Illumination_Geometry>
                        <geom:Illumination_Specific>
                            <geom:solar_elongation unit="deg">{{ solar_elongation }}</geom:solar_elongation>
                        </geom:Illumination_Specific>
                    </geom:Illumination_Geometry>
                    {% endif %}
                </geom:Geometry_Orbiter>
            </geom:Geometry>
            {% endif %}
            
            {% if proclevl != '0A' %}
            <!-- Image dictionary-->
            <img:Imaging>
                <pds:Local_Internal_Reference>
                    <pds:local_identifier_reference>{{ data_local_id }}</pds:local_identifier_reference>
                    <pds:local_reference_type>imaging_parameters_to_image_object</pds:local_reference_type>
                </pds:Local_Internal_Reference>

                <!-- ONLY inject Calibration blocks for Level 1B and higher -->
                {% if proclevl in ['1B', '1C'] %}
                <img:Calibration>
                    <img:description>Calibration procedures applied vary by processing level. Procedures in order: dark current, flat field, bad pixel (by averaging neighbours), Spectral Radiance, I/F reflectance.</img:description>
                    <img:processing_venue>Ground</img:processing_venue>
                </img:Calibration>
                <img:Dark_Current_Correction>
                    <img:processing_venue>Ground</img:processing_venue>
                </img:Dark_Current_Correction>
                <img:Flat_Field_Correction>
                    <img:processing_venue>Ground</img:processing_venue>
                </img:Flat_Field_Correction>
                <img:Radiometric_Correction>
                    <img:processing_venue>Ground</img:processing_venue>
                    <img:radiometric_type>{{ radiometric_type }}</img:radiometric_type>
                </img:Radiometric_Correction>
                {% endif %}

                <!-- Instrument state -->
                <img:Instrument_State>
                    <!-- Exposure time is valid for ALL levels (0A, 1A, 1B, 1C) -->
                    <!-- ONLY inject Temperatures for Level 1A and higher (when DNs have been converted to Kelvin) -->
                    {% if proclevl != '0A' %}
                    <img:Device_Temperatures>
                        {%- if vis_ccdtemp not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>Vis CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ vis_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir1_ccdtemp not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR1 CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir2_ccdtemp not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR2 CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if swir_ccdtemp not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>SWIR CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ swir_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if vis_fpi_temp1 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>Vis FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ vis_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if vis_fpi_temp2 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>Vis FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ vis_fpi_temp2 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir1_fpi_temp1 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir1_fpi_temp2 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_fpi_temp2 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir2_fpi_temp1 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if nir2_fpi_temp2 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_fpi_temp2 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if swir_fpi_temp1 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ swir_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                        {%- if swir_fpi_temp2 not in ['UNK', 'N/A'] %}
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ swir_fpi_temp2 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {%- endif %}
                    </img:Device_Temperatures>
                    {% endif %}
                </img:Instrument_State>
            </img:Imaging>
            {% endif %}


            {% if proclevl != '0A' %}
            <!-- Spectral dictionary-->
            <sp:Spectral_Characteristics>
                <pds:Local_Internal_Reference>
                    <pds:local_identifier_reference>{{ data_local_id }}</pds:local_identifier_reference>
                    <pds:local_reference_type>spectral_characteristics_to_array_object</pds:local_reference_type>
                </pds:Local_Internal_Reference>

                <sp:spectrum_format>{{ spectrum_format }}</sp:spectrum_format>
                <sp:spectral_bin_type>wavelength</sp:spectral_bin_type>

                <sp:Observation_Parameters>
                    <sp:number_of_exposures>{{ extensions[0].data_shape[0] }}</sp:number_of_exposures>
                    <!--TODO: The net integration time for FPI is the observation interval-->
                    <sp:net_integration_time unit="s">{{ net_integration_time }}</sp:net_integration_time>
                </sp:Observation_Parameters>

                <sp:Field_of_View>
                    {% if channel == 'Vis' %}
                    <sp:description>Vis has a rectangular FoV.</sp:description>
                    <sp:Rectangular_FOV>
                        <sp:width_angle unit="deg">10</sp:width_angle>
                        <sp:length_angle unit="deg">10</sp:length_angle>
                    </sp:Rectangular_FOV>
                    {% elif channel in ['NIR1', 'NIR2'] %}
                    <sp:description>Vis has a square FoV.</sp:description>
                    <sp:Rectangular_FOV>
                        <sp:width_angle unit="deg">6.7</sp:width_angle>
                        <sp:length_angle unit="deg">5.4</sp:length_angle>
                    </sp:Rectangular_FOV>
                    {% elif channel == 'SWIR' %}
                    <sp:description>MIR has a circular FoV.</sp:description>
                    <sp:Circular_FOV>
                        <sp:diameter_angle unit="deg">2</sp:diameter_angle>
                    </sp:Circular_FOV>
                    {% endif %}
                </sp:Field_of_View>

                <sp:Bin_Description>
                    <sp:bin_profile_description>The spectral bins follow a gaussian distribution. Width given as FWHM.</sp:bin_profile_description>
                    <!--TODO: Should use Uniformly_Sampled_wavelength or Spectral_Lookup? -->
                    <sp:Uniformly_Sampled_Wavelength>
                        <!--TODO: Check Axis name -->
                        <sp:axis_name>Wavelength</sp:axis_name>
                        <!--TODO: Check sampling interval-->
                        <sp:sampling_interval_wavelength unit="nm">{{ sampling_interval }}</sp:sampling_interval_wavelength>
                        <sp:sampling_scale>Linear</sp:sampling_scale>
                        <!--TODO: Check bin width-->
                        <sp:bin_width_wavelength unit="nm">{{ bin_width }}</sp:bin_width_wavelength>
                        <sp:first_center_wavelength unit="nm">{{ first_center }}</sp:first_center_wavelength>
                        <sp:last_center_wavelength unit="nm">{{ last_center }}</sp:last_center_wavelength>
                    </sp:Uniformly_Sampled_Wavelength>
                </sp:Bin_Description>

            </sp:Spectral_Characteristics>
            {% endif %}
        </Discipline_Area>
    </Observation_Area>

    {% if reference_list %}
    <Reference_List>
        <Source_Product_Internal>
            <lidvid_reference>urn:nasa:pds:ci_mirmis:nirmir:image000_0a::1.0</lidvid_reference>
            <reference_type>data_to_raw_source_product</reference_type>
        </Source_Product_Internal>
        {% if proclevl in ['1A-extra', '1B', '1C'] %}
        <Source_Product_Internal>
            <lidvid_reference>urn:nasa:pds:ci_mirmis:nirmir:image000_1a::1.0</lidvid_reference>
            <reference_type>data_to_partially_processed_source_product</reference_type>
        </Source_Product_Internal>
        {% endif %}
        {% if proclevl == '1C' %}
        <Source_Product_Internal>
            <lidvid_reference>urn:nasa:pds:ci_mirmis:nirmir:image0001_1b::1.0</lidvid_reference>
            <reference_type>data_to_calibrated_source_product</reference_type>
        </Source_Product_Internal>
        {% endif %}
    </Reference_List>
    {% endif %}


    <File_Area_Observational>
        <File>
            <file_name>{{ file_name }}</file_name>
            <local_identifier>data_file</local_identifier>
            <creation_date_time>{{ creation_date_time }}</creation_date_time>
            <file_size unit="byte">{{ file_size }}</file_size>
            <md5_checksum>{{ file_md5_checksum }}</md5_checksum>
        </File>
        <Header>
            <name>Primary Header</name>
            <offset unit="byte">{{ extensions[0].header_offset }}</offset>
            <object_length unit="byte">{{ extensions[0].header_length }}</object_length>
            <parsing_standard_id>FITS 3.0</parsing_standard_id>
            <description>Primary FITS header containing observation metadata.</description>
        </Header>
        {% if channel in 'Vis', 'NIR1', 'NIR2' %}
        {# Vis, NIR1, NIR2: 3-D hyperspectral cube [Wavelength × Line × Sample] #}
        <Array_3D_Spectrum>
            <name>Hyperspectral Image Cube</name>
            <local_identifier>data_cube</local_identifier>
            <offset unit="byte">{{ extensions[0].data_offset }}</offset><!-- Always a multiple of 2880 -->
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <Element_Array>
                <data_type>{{ pds4_data_type }}</data_type>
                <unit>{{ data_unit }}</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Wavelength</axis_name>
                <elements>{{ extensions[0].data_shape[0] }}</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>{{ extensions[0].data_shape[1] }}</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>{{ extensions[0].data_shape[2] }}</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D_Spectrum>
        {% if extensions | length > 1 %}
        {# NIR 1A-extra/1B/1C: BinTable extension containing raw frame data #}
        <Header>
            <name>BinTable Header</name>
            <offset unit="byte">{{ extensions[1].header_offset }}</offset>
            <object_length unit="byte">{{ extensions[1].header_length }}</object_length>
            <parsing_standard_id>FITS 3.0</parsing_standard_id>
            <description>FITS binary table extension header for raw per-frame pixel data.</description>
        </Header>
        <!--TODO: Add Table_Binary description for the BinTable raw frame data -->
        {% endif %}
        {% else %}
        {# SWIR: 1-D spectrum, one value per wavelength #}
        <Array_1D_Spectrum>
            <name>Spectral Data</name>
            <local_identifier>data_spectrum</local_identifier>
            <offset unit="byte">{{ extensions[0].data_offset }}</offset><!-- Always a multiple of 2880 -->
            <axes>1</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <Element_Array>
                <data_type>{{ pds4_data_type }}</data_type>
                <unit>{{ data_unit }}</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Wavelength</axis_name>
                <elements>{{ extensions[0].data_shape[0] }}</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
        </Array_1D_Spectrum>
        {% endif %}
    </File_Area_Observational>

</Product_Observational>
