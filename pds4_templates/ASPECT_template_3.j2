<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://pds.nasa.gov/pds4/geom/v1/PDS4_GEOM_1P00_19B0.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/img/v1/PDS4_IMG_1P00_1930.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/sp/v1/PDS4_SP_1P00_1330.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1O00.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="https://pds.nasa.gov/pds4/disp/v1/PDS4_DISP_1O00_1510.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="../schema/PDS4_PSA_1O00_1500.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="../schema/PDS4_HERA_1O00_1000.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>

<!--TODO: Change to rel path -->
<Product_Observational 
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:disp="http://pds.nasa.gov/pds4/disp/v1"
    xmlns:geom="http://pds.nasa.gov/pds4/geom/v1"
    xmlns:img="http://pds.nasa.gov/pds4/img/v1"
    xmlns:sp="http://pds.nasa.gov/pds4/sp/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pds="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:psa="http://psa.esa.int/psa/v1"
    xmlns:hera="http://pds.nasa.gov/pds4/mission/hera/v1"
    xsi:schemaLocation="
    http://pds.nasa.gov/pds4/pds/v1 https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1O00.xsd
    http://pds.nasa.gov/pds4/disp/v1 https://pds.nasa.gov/pds4/disp/v1/PDS4_DISP_1O00_1510.xsd
    http://pds.nasa.gov/pds4/geom/v1 https://pds.nasa.gov/pds4/geom/v1/PDS4_GEOM_1P00_19B0.xsd
    http://pds.nasa.gov/pds4/img/v1 https://pds.nasa.gov/pds4/img/v1/PDS4_IMG_1P00_1930.xsd
    http://pds.nasa.gov/pds4/sp/v1 https://pds.nasa.gov/pds4/sp/v1/PDS4_SP_1P00_1330.xsd 
    http://psa.esa.int/psa/v1 ../schema/PDS4_PSA_1O00_1500.xsd
    http://pds.nasa.gov/pds4/mission/hera/v1 ../schema/PDS4_HERA_1O00_1000.xsd
    ">

    <!--TODO: Check correct Bundle and Collection -->
    <Identification_Area>
        <logical_identifier>{{ main_logical_lid }}</logical_identifier>
        <version_id>{{ version_id | default('1.0') }}</version_id>
        <title>{{ title }}</title>
        <information_model_version>1.24.0.0</information_model_version>
        <product_class>Product_Observational</product_class>
        <Modification_History>
            <Modification_Detail>
                <modification_date>{{ modification_date }}</modification_date>
                <version_id>{{ version_id | default('1.0') }}</version_id>
                <description>Initial template.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>

    <Observation_Area>
        <Time_Coordinates>
            <!--TODO: acquisition stop time should be provided in telemetry or externally -->
            <start_date_time>{{ start_date_time }}</start_date_time>
            <stop_date_time>{{ stop_date_time | default(start_date_time) }}</stop_date_time>
        </Time_Coordinates>

        <!-- Primary Result Summary is optional (used in LTM)-->
        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <!-- Processing levels: Calibrated, Derived, Partially Processed, Raw, Telemetry-->
            <processing_level>{{ processing_level | default('Derived') }}</processing_level>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Infrared</wavelength_range>
                <discipline_name>Spectroscopy</discipline_name>
            </Science_Facets>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Infrared</wavelength_range>
                <discipline_name>Imaging</discipline_name>
            </Science_Facets>
        </Primary_Result_Summary>

        <Investigation_Area>
            <name>Hera</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>{{ mission_lid }}</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>

        <Observing_System>
            <name>{{ os_name | default('ASPECT') }}</name>
            <Observing_System_Component>
                <name>ASPECT</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>{{ aspect_lid }}</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            {% if channels is defined and channels %}
                {% for ch in channels %}
                <Observing_System_Component>
                    <name>{{ ch.channel_name | default(ch.name) }}</name>
                    <type>Instrument</type>
                    <Internal_Reference>
                        <!--TODO: check the correct lid reference -->
                        <lid_reference>{{ ch.instrument_lid | default(ch.lid) }}</lid_reference>
                        <reference_type>is_instrument</reference_type>
                    </Internal_Reference>
                </Observing_System_Component>
                {% endfor %}
            {% else %}
                {% for ch in channel.split(',') %}
                {% set ch_clean = ch.strip() %}
                <Observing_System_Component>
                    <name>{{ ch_clean }}</name>
                    <type>Instrument</type>
                    <Internal_Reference>
                        <!--TODO: check the correct lid reference -->
                        <lid_reference>urn:nasa:pds:context:instrument:aspect.{{ ch_clean.lower() }}</lid_reference>
                        <reference_type>is_instrument</reference_type>
                    </Internal_Reference>
                </Observing_System_Component>
                {% endfor %}
            {% endif %}
        </Observing_System>

        <Target_Identification>
            <name>{{ target }}</name>
            <type>Asteroid</type>
            <Internal_Reference>
                <lid_reference>{{ target_lid }}</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>

        <Mission_Area>
            <psa:Mission_Information>
                <psa:mission_phase_name>{{ hera_phase_name }}</psa:mission_phase_name>
                <psa:mission_phase_identifier>{{ hera_phase_id }}</psa:mission_phase_identifier>
            </psa:Mission_Information>
            <hera:Milani_Status>
                <hera:milani_mission_phase>{{ milani_phase }}</hera:milani_mission_phase>
            </hera:Milani_Status>
        </Mission_Area>

        <Discipline_Area>
            <!-- Image display guide (Vis, NIR1, NIR2 only: MIR has 1D spectrum, no spatial axes) -->
            <disp:Display_Settings>
                <pds:Local_Internal_Reference>
                    <!-- Local identifier for the datacube defined in File_Area_observational-->
                    <pds:local_identifier_reference>{{ data_local_id | default('data_cube') }}</pds:local_identifier_reference>
                    <pds:local_reference_type>display_settings_to_array</pds:local_reference_type>
                </pds:Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Top to Bottom</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>

            <!-- Geometry dictionary-->
            <!-- These values comes from SPICE kernel and are optional to include-->

            <!-- Image dictionary-->
            <img:Imaging>
                <pds:Local_Internal_Reference>
                    <pds:local_identifier_reference>{{ data_local_id | default('data_cube') }}</pds:local_identifier_reference>
                    <pds:local_reference_type>imaging_parameters_to_image_object</pds:local_reference_type>
                </pds:Local_Internal_Reference>

                <img:Dark_Current_Correction>
                    <img:active_flag>true</img:active_flag>
                    <img:processing_venue>Ground</img:processing_venue>
                </img:Dark_Current_Correction>
                <img:Detector>
                    <img:bad_pixel_replacement_flag>true</img:bad_pixel_replacement_flag>
                    <!-- Optional: ID or name of the table/map used -->
                    <!-- <img:bad_pixel_replacement_table_id>1</img:bad_pixel_replacement_table_id> -->
                </img:Detector>
                <img:Flat_Field_Correction>
                    <img:active_flag>true</img:active_flag>
                    <img:processing_venue>Ground</img:processing_venue>
                </img:Flat_Field_Correction>
                <img:Radiometric_Correction>
                    <img:active_flag>true</img:active_flag>
                    <img:radiometric_type>{{ radiometric_type }}</img:radiometric_type>
                </img:Radiometric_Correction>


                <!-- Instrument state -->
                <img:Instrument_State>
                    <!-- Exposure time is valid for ALL levels (0A, 1A, 1B, 1C) -->
                    <!-- ONLY inject Temperatures for Level 1A and higher (when DNs have been converted to Kelvin) -->
                    <img:Device_Temperatures>
                        <img:Device_Temperature>
                            <img:device_name>Vis CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ vis_ccdtemp | default('288.38') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ swir_ccdtemp | default('277.14') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_fpi_temp1 | default('285.24') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_fpi_temp2 | default('277.25') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_fpi_temp1 | default('285.45') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_fpi_temp2 | default('276.71') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ swir_fpi_temp1 | default('283.58') }}</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">{{ swir_fpi_temp2 | default('276.21') }}</img:temperature_value>
                        </img:Device_Temperature>
                    </img:Device_Temperatures>
                </img:Instrument_State>
            </img:Imaging>
        </Discipline_Area>
    </Observation_Area>

    <!-- Provenance: Input Level 2 derived product used to generate Level 3 -->
    <Reference_List>
        <Source_Product_Internal>
            <lidvid_reference>{{ derived_to_source_id }}</lidvid_reference>
            <reference_type>data_to_derived_source_product</reference_type>
        </Source_Product_Internal>
    </Reference_List>

    <File_Area_Observational>
        <File>
            <file_name>{{ file_name }}</file_name>
            <local_identifier>data_file</local_identifier>
            <creation_date_time>{{ creation_date_time | default(modification_date) }}</creation_date_time>
            <file_size unit="byte">{{ file_size }}</file_size>
            <md5_checksum>{{ file_md5_checksum }}</md5_checksum>
        </File>
        <Header>
            <name>Primary Header</name>
            <offset unit="byte">0</offset>
            <object_length unit="byte">{{ extensions[0]['header_bytes'] | default('8640') }}</object_length>
            <parsing_standard_id>FITS 3.0</parsing_standard_id>
            <description>Primary FITS header containing observation metadata.</description>
        </Header>
        
        <!-- Primary Merged Hyperspectral Cube HDU -->
        <Array_3D_Spectrum>
            <name>Merged Hyperspectral Image Cube</name>
            <local_identifier>data_cube</local_identifier>
            <offset unit="byte">{{ extensions[0]['data_offset'] | default('14400') }}</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>Level 2B merged hyperspectral cube in I/F reflectance. Vis channel frames (1024x1024) were co-registered and resampled onto the NIR grid (640x512) using homography estimated with ORB features and RANSAC. Vis (11 bands), NIR1 (13 bands), and NIR2 (13 bands) are stacked along the wavelength axis.</description>
            <Element_Array>
                <data_type>{{ pds4_data_type | default('IEEE754MSBSingle') }}</data_type>
                <unit>{{ data_unit | default('1') }}</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Wavelength</axis_name>
                <elements>{{ extensions[0]['naxis3'] | default('37') }}</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>{{ extensions[0]['naxis2'] | default('512') }}</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>{{ extensions[0]['naxis1'] | default('640') }}</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D_Spectrum>
        
        <!-- Mineral Composition Cube HDU -->
        <Array_3D>
            <name>Mineral Composition and Chemistry Cube</name>
            <local_identifier>composition_cube</local_identifier>
            <offset unit="byte">{{ extensions[1]['data_offset'] | default('17280') if extensions|length > 1 else '17280' }}</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>Level 3C mineral composition cube generated via convolutional neural network (CNN) from the Level 2B merged reflectance cube. The 10 layers along the Band axis represent:
                LAYER_00= 'OL (vol%)'          / Olivine volume percentage                      
                LAYER_01= 'OPX (vol%)'         / Orthopyroxene volume percentage
                LAYER_02= 'CPX (vol%)'         / Clinopyroxene volume percentage
                LAYER_03= 'Fa (OL) '           / Fayalite component in olivine                  
                LAYER_04= 'Fo (OL) '           / Forsterite component in olivine
                LAYER_05= 'Fs (OPX)'           / Ferrosilite component in orthopyroxene
                LAYER_06= 'En (OPX)'           / Enstatite component in orthopyroxene
                LAYER_07= 'Fs (CPX)'           / Ferrosilite component in clinopyroxene
                LAYER_08= 'En (CPX)'           / Enstatite component in clinopyroxene
                LAYER_09= 'Wo (CPX)'           / Wollastonite component in clinopyroxene 
            </description>
            <Element_Array>
                <data_type>{{ pds4_data_type | default('IEEE754MSBSingle') }}</data_type>
                <unit>1</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Band</axis_name>
                <elements>{{ extensions[1]['naxis3'] | default('10') if extensions|length > 1 else '10' }}</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>{{ extensions[1]['naxis2'] | default('512') if extensions|length > 1 else '512' }}</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>{{ extensions[1]['naxis1'] | default('640') if extensions|length > 1 else '640' }}</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D>
    </File_Area_Observational>
</Product_Observational>