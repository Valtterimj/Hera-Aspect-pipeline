<?xml-model href="file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_HERA_1O00_1000.sch"     schematypens="http://purl.oclc.org/dsdl/schematron"?>

<!--TODO: Change to rel path -->
<Product_Observational 
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:disp="http://pds.nasa.gov/pds4/disp/v1"
    xmlns:geom="http://pds.nasa.gov/pds4/geom/v1"
    xmlns:img="http://pds.nasa.gov/pds4/img/v1"
    xmlns:sp="http://pds.nasa.gov/pds4/sp/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pds="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:psa="http://psa.esa.int/psa/v1"
    xmlns:hera="http://pds.nasa.gov/pds4/mission/hera/v1"
    xsi:schemaLocation="
        http://pds.nasa.gov/pds4/pds/v1 https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1O00.xsd
        http://pds.nasa.gov/pds4/disp/v1 https://pds.nasa.gov/pds4/disp/v1/PDS4_DISP_1O00_1510.xsd
        http://pds.nasa.gov/pds4/geom/v1 https://pds.nasa.gov/pds4/geom/v1/PDS4_GEOM_1P00_19B0.xsd
        http://pds.nasa.gov/pds4/img/v1 https://pds.nasa.gov/pds4/img/v1/PDS4_IMG_1P00_1930.xsd
        http://pds.nasa.gov/pds4/sp/v1 https://pds.nasa.gov/pds4/sp/v1/PDS4_SP_1P00_1330.xsd 
        http://psa.esa.int/psa/v1 file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_PSA_1O00_1500.xsd
        http://pds.nasa.gov/pds4/mission/hera/v1 file:/C:/Users/NotEW/Documents/ASPECT-pipeline/New_Pipeline/Hera-Aspect-pipeline/pds4_dev/PDS4_HERA_1O00_1000.xsd
        "
 >

    <Identification_Area>
        <logical_identifier>{{ main_logical_lid }}</logical_identifier>
        <version_id>1.0</version_id>
        <title>{{ title }}</title>
        <information_model_version>1.24.0.0</information_model_version>
        <product_class>Product_Observational</product_class>
        <Modification_History>
            <Modification_Detail>
                <modification_date>{{ modification_date }}</modification_date>
                <version_id>1.0</version_id>
                <description>Level 2B merged Vis-NIR product.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>

    <Observation_Area>
        <Time_Coordinates>
            <start_date_time>{{ start_date_time }}</start_date_time>
            <stop_date_time>{{ stop_date_time }}</stop_date_time>
        </Time_Coordinates>

        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <processing_level>Derived</processing_level>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Near Infrared</wavelength_range>
                <discipline_name>Spectroscopy</discipline_name>
            </Science_Facets>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <wavelength_range>Near Infrared</wavelength_range>
                <discipline_name>Imaging</discipline_name>
            </Science_Facets>
        </Primary_Result_Summary>

        <Investigation_Area>
            <name>Hera</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>{{ mission_lid }}</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>

        <Observing_System>
            <name>Milani / ASPECT Combined</name>
            <Observing_System_Component>
                <name>Milani</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>{{ aspect_lid }}</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            <Observing_System_Component>
                <name>ASPECT</name>
                <type>Instrument</type>
                <Internal_Reference>
                    <lid_reference>{{ instrument_lid }}</lid_reference>
                    <reference_type>is_instrument</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
        </Observing_System>

        <Target_Identification>
            <name>{{ target }}</name>
            <type>{{ target_type }}</type>
            <Internal_Reference>
                <lid_reference>{{ target_lid }}</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>

        <Mission_Area>
            <psa:Mission_Information>
                <psa:mission_phase_name>ASPECT_Acquisition</psa:mission_phase_name>
                <psa:mission_phase_identifier>A2Acq1</psa:mission_phase_identifier>
            </psa:Mission_Information>
            <hera:Spacecraft_Status>
                <hera:milani_mission_phase>Stowed</hera:milani_mission_phase>
            </hera:Spacecraft_Status>
        </Mission_Area>

        <Discipline_Area>
            <!-- Display Settings for the 640x512 resampled image -->
            <disp:Display_Settings>
                <Local_Internal_Reference>
                    <local_identifier_reference>{{ data_local_id }}</local_identifier_reference>
                    <local_reference_type>display_settings_to_array</local_reference_type>
                </Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Top to Bottom</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>

            <!-- SPICE Geometry (optional) -->
            {% if mk_file_name not in ['UNK', 'N/A', None] %}
            <geom:Geometry>
                <geom:SPICE_Kernel_Files>
                    <geom:SPICE_Kernel_Identification>
                        <geom:kernel_type>MK</geom:kernel_type>
                        <geom:spice_kernel_file_name>{{ mk_file_name }}</geom:spice_kernel_file_name>
                    </geom:SPICE_Kernel_Identification>
                </geom:SPICE_Kernel_Files>
                <geom:Geometry_Orbiter>
                    <geom:geometry_start_time_utc>{{ start_date_time }}</geom:geometry_start_time_utc>
                    <geom:geometry_stop_time_utc>{{ stop_date_time }}</geom:geometry_stop_time_utc>
                </geom:Geometry_Orbiter>
            </geom:Geometry>
            {% endif %}

            <!-- Image Dictionary (Housekeeping temperatures) -->
            <img:Imaging>
                <Local_Internal_Reference>
                    <local_identifier_reference>{{ data_local_id }}</local_identifier_reference>
                    <local_reference_type>imaging_parameters_to_image_object</local_reference_type>
                </Local_Internal_Reference>

                <img:Instrument_State>
                    <img:Device_Temperatures>
                        {% if vis_ccdtemp not in ['UNK', 'N/A', None] %}
                        <img:Device_Temperature>
                            <img:device_name>Vis CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ vis_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {% endif %}
                        {% if nir1_fpi_temp1 not in ['UNK', 'N/A', None] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir1_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {% endif %}
                        {% if nir2_fpi_temp1 not in ['UNK', 'N/A', None] %}
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">{{ nir2_fpi_temp1 }}</img:temperature_value>
                        </img:Device_Temperature>
                        {% endif %}
                        {% if swir_ccdtemp not in ['UNK', 'N/A', None] %}
                        <img:Device_Temperature>
                            <img:device_name>SWIR CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">{{ swir_ccdtemp }}</img:temperature_value>
                        </img:Device_Temperature>
                        {% endif %}
                    </img:Device_Temperatures>
                </img:Instrument_State>
            </img:Imaging>

            <!-- Spectral Dictionary: Non-uniform 37 merged bands -->
            <sp:Spectral_Characteristics>
                <Local_Internal_Reference>
                    <local_identifier_reference>{{ data_local_id }}</local_identifier_reference>
                    <local_reference_type>spectral_characteristics_to_array_object</local_reference_type>
                </Local_Internal_Reference>

                <sp:spectrum_format>3D</sp:spectrum_format>
                <sp:spectral_bin_type>wavelength</sp:spectral_bin_type>

                <sp:Observation_Parameters>
                    <sp:number_of_exposures>{{ extensions[0].data_shape[0] }}</sp:number_of_exposures>
                    <sp:net_integration_time unit="s">{{ net_integration_time }}</sp:net_integration_time>
                </sp:Observation_Parameters>

                <!-- Level 2B images are co-registered to the NIR FoV -->
                <sp:Field_of_View>
                    <sp:description>Resampled to the NIR field of view.</sp:description>
                    <sp:Rectangular_FOV>
                        <sp:width_angle unit="deg">6.7</sp:width_angle>
                        <sp:length_angle unit="deg">5.4</sp:length_angle>
                    </sp:Rectangular_FOV>
                </sp:Field_of_View>

                <sp:Bin_Description>
                    <sp:bin_profile_description>Merged band centers from Vis, NIR1, and NIR2 channels.</sp:bin_profile_description>
                    <sp:Axis_Bin_Set_Wavelength>
                        <sp:axis_name>Wavelength</sp:axis_name>
                        {% for band in bands %}
                        <sp:Bin_Wavelength>
                            <sp:bin_sequence_number>{{ loop.index }}</sp:bin_sequence_number>
                            <sp:center_wavelength unit="nm">{{ band.center_wl }}</sp:center_wavelength>
                            <sp:bin_width_wavelength unit="nm">{{ band.bin_width }}</sp:bin_width_wavelength>
                        </sp:Bin_Wavelength>
                        {% endfor %}
                    </sp:Axis_Bin_Set_Wavelength>
                </sp:Bin_Description>
            </sp:Spectral_Characteristics>
        </Discipline_Area>
    </Observation_Area>

    <!-- Provenance: The 3 input Level 1C channel products stacked into Level 2B -->
    <Reference_List>
        <Source_Product_Internal>
            <lidvid_reference>{{ source_vis_lidvid }}</lidvid_reference>
            <reference_type>data_to_calibrated_source_product</reference_type>
        </Source_Product_Internal>
        <Source_Product_Internal>
            <lidvid_reference>{{ source_nir1_lidvid }}</lidvid_reference>
            <reference_type>data_to_calibrated_source_product</reference_type>
        </Source_Product_Internal>
        <Source_Product_Internal>
            <lidvid_reference>{{ source_nir2_lidvid }}</lidvid_reference>
            <reference_type>data_to_calibrated_source_product</reference_type>
        </Source_Product_Internal>
    </Reference_List>

    <!-- Merged 3D FITS datacube on disk -->
    <File_Area_Observational>
        <File>
            <file_name>{{ file_name }}</file_name>
            <local_identifier>data_file</local_identifier>
            <creation_date_time>{{ creation_date_time }}</creation_date_time>
            <file_size unit="byte">{{ file_size }}</file_size>
            <md5_checksum>{{ file_md5_checksum }}</md5_checksum>
        </File>

        <Header>
            <name>Primary Header</name>
            <offset unit="byte">{{ extensions[0].header_offset }}</offset>
            <object_length unit="byte">{{ extensions[0].header_length }}</object_length>
            <parsing_standard_id>FITS 3.0</parsing_standard_id>
            <description>Primary FITS header containing observation metadata and homography parameters.</description>
        </Header>

        <Array_3D_Spectrum>
            <name>Merged Hyperspectral Image Cube</name>
            <local_identifier>data_cube</local_identifier>
            <offset unit="byte">{{ extensions[0].data_offset }}</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>Level 2B merged hyperspectral cube in I/F reflectance. Vis frames (1024x1024) were co-registered and resampled onto the NIR grid (640x512) via homography. Vis (11 bands), NIR1 (13 bands), and NIR2 (13 bands) are stacked along the wavelength axis.</description>
            <Element_Array>
                <data_type>{{ pds4_data_type }}</data_type>
                <unit>{{ data_unit }}</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Wavelength</axis_name>
                <elements>{{ extensions[0].data_shape[0] }}</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>{{ extensions[0].data_shape[1] }}</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>{{ extensions[0].data_shape[2] }}</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D_Spectrum>
    </File_Area_Observational>
</Product_Observational>