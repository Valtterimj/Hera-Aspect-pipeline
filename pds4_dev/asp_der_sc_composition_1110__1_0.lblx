            <name>Primary Header</name>
            <offset unit="byte">0</offset>
            <object_length unit="byte">8640</object_length>
            <parsing_standard_id>FITS 3.0</parsing_standard_id>
            <description>Primary FITS header containing observation metadata.</description>
        </Header>
        
        
        <Array_3D_Spectrum>
            <name>Merged Hyperspectral Image Cube</name>
            <local_identifier>data_cube</local_identifier>
            <offset unit="byte">14400</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>Level 2B merged hyperspectral cube in I/F reflectance. Vis channel frames (1024x1024) were co-registered and resampled onto the NIR grid (640x512) using homography estimated with ORB features and RANSAC. Vis (11 bands), NIR1 (13 bands), and NIR2 (13 bands) are stacked along the wavelength axis.</description>
            <Element_Array>
                <data_type>IEEE754MSBSingle</data_type>
                <unit>1</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Wavelength</axis_name>
                <elements>37</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>512</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>640</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D_Spectrum>
        
        <Array_3D>
            <name>Mineral Composition and Chemistry Cube</name>
            <local_identifier>composition_cube</local_identifier>
            <offset unit="byte">17280</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>Level 3C mineral composition cube generated via convolutional neural network (CNN) from the Level 2B merged reflectance cube. The 10 layers along the Band axis represent:
                LAYER_00= 'OL (vol%)'          / Olivine volume percentage                      
                LAYER_01= 'OPX (vol%)'         / Orthopyroxene volume percentage
                LAYER_02= 'CPX (vol%)'         / Clinopyroxene volume percentage
                LAYER_03= 'Fa (OL) '           / Fayalite component in olivine                  
                LAYER_04= 'Fo (OL) '           / Forsterite component in olivine
                LAYER_05= 'Fs (OPX)'           / Ferrosilite component in orthopyroxene
                LAYER_06= 'En (OPX)'           / Enstatite component in orthopyroxene
                LAYER_07= 'Fs (CPX)'           / Ferrosilite component in clinopyroxene
                LAYER_08= 'En (CPX)'           / Enstatite component in clinopyroxene
                LAYER_09= 'Wo (CPX)'           / Wollastonite component in clinopyroxene 
            </description>
            <Element_Array>
                <data_type>IEEE754MSBSingle</data_type>
                <unit>1</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Band</axis_name>
                <elements>10</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>512</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>640</elements>
                <sequence_number>3</sequence_number>
            </Axis_Array>
        </Array_3D>
        
        
    </File_Area_Observational>

