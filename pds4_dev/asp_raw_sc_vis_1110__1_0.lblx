            <!-- Geometry dictionary-->
            <!-- These values comes from SPICE kernel and are optional to include-->
            
            
            
            <!-- Image dictionary-->
            <img:Imaging>
                <pds:Local_Internal_Reference>
                    <pds:local_identifier_reference>data_cube</pds:local_identifier_reference>
                    <pds:local_reference_type>imaging_parameters_to_image_object</pds:local_reference_type>
                </pds:Local_Internal_Reference>

                <!-- ONLY inject Calibration blocks for Level 1B and higher -->
                

                <!-- Instrument state -->
                <img:Instrument_State>
                    <!-- Exposure time is valid for ALL levels (0A, 1A, 1B, 1C) -->
                    <!-- ONLY inject Temperatures for Level 1A and higher (when DNs have been converted to Kelvin) -->
                    
                    <img:Device_Temperatures>
                        <img:Device_Temperature>
                            <img:device_name>Vis CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">288.38</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR CCDTEMP</img:device_name>
                            <img:temperature_value unit="K">277.14</img:temperature_value>
