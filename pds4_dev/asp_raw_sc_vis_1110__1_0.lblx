                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">285.24</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR1 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">277.25</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">285.45</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>NIR2 FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">276.71</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP1</img:device_name>
                            <img:temperature_value unit="K">283.58</img:temperature_value>
                        </img:Device_Temperature>
                        <img:Device_Temperature>
                            <img:device_name>SWIR FPI TEMP2</img:device_name>
                            <img:temperature_value unit="K">276.21</img:temperature_value>
                        </img:Device_Temperature>
                    </img:Device_Temperatures>
                    
                </img:Instrument_State>
            </img:Imaging>
            


            
            <!-- Spectral dictionary-->
            <sp:Spectral_Characteristics>
                <pds:Local_Internal_Reference>
                    <pds:local_identifier_reference>data_cube</pds:local_identifier_reference>
                    <pds:local_reference_type>spectral_characteristics_to_array_object</pds:local_reference_type>
                </pds:Local_Internal_Reference>

                <sp:spectrum_format>3D</sp:spectrum_format>
                <sp:spectral_bin_type>wavelength</sp:spectral_bin_type>

                <sp:Observation_Parameters>
                    <sp:number_of_exposures>11</sp:number_of_exposures>
                    <!--TODO: The net integration time for FPI is the observation interval-->
                    <sp:net_integration_time unit="s">1</sp:net_integration_time>
                </sp:Observation_Parameters>

                <sp:Field_of_View>
                    
                    <sp:description>Vis has a rectangular FoV.</sp:description>
                    <sp:Rectangular_FOV>
                        <sp:width_angle unit="deg">10</sp:width_angle>
                        <sp:length_angle unit="deg">10</sp:length_angle>
                    </sp:Rectangular_FOV>
                    
                </sp:Field_of_View>

                <sp:Bin_Description>
                    <sp:bin_profile_description>The spectral bins follow a gaussian distribution. Width given as FWHM.</sp:bin_profile_description>
                    <!--TODO: Should use Uniformly_Sampled_wavelength or Spectral_Lookup? -->
                    <sp:Uniformly_Sampled_Wavelength>
                        <!--TODO: Check Axis name -->
                        <sp:axis_name>Wavelength</sp:axis_name>
                        <!--TODO: Check sampling interval-->
                        <sp:sampling_interval_wavelength unit="nm">30</sp:sampling_interval_wavelength>
                        <sp:sampling_scale>Linear</sp:sampling_scale>
                        <!--TODO: Check bin width-->
                        <sp:bin_width_wavelength unit="nm">30</sp:bin_width_wavelength>
                        <sp:first_center_wavelength unit="nm">675.0</sp:first_center_wavelength>
                        <sp:last_center_wavelength unit="nm">825.0</sp:last_center_wavelength>
                    </sp:Uniformly_Sampled_Wavelength>
                </sp:Bin_Description>

            </sp:Spectral_Characteristics>
            
